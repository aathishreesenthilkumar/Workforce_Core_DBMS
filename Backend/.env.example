# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection Configuration
# Option A: Connection URL format
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management_db

# Option B: Individual parameter format (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_actual_postgres_password_here
PGDATABASE=employee_management_db

# Session Secret (Change in production to a secure random string)
SESSION_SECRET=dbms_employee_payroll_secure_session_secret_key_2026

